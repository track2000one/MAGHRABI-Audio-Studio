# Core runtime
DATA_DIR=/data
MAX_UPLOAD_MB=250
DEMUCS_MODEL=htdemucs
MAX_WORKERS=1

# Login authentication (set strong real values in Railway Variables)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=43200

# Production API surface
# Keep public FastAPI docs disabled in Production. Set to 1 only for controlled troubleshooting.
ENABLE_API_DOCS=0

# Optional PostgreSQL control-plane database.
# Leave empty to use the local SQLite fallback under DATA_DIR.
DATABASE_URL=

# GitOps / Final Production Readiness evidence lookup.
V31_GITHUB_REPOSITORY=track2000one/MAGHRABI-Audio-Studio
# Optional GitHub token for authenticated Actions/Attestations API reads from Railway.
# Never commit a real token to the repository.
V31_GITHUB_TOKEN=

# Optional deployment webhook integration used by the GitOps layer.
V31_DEPLOY_WEBHOOK_URL=
V31_DEPLOY_WEBHOOK_TOKEN=
